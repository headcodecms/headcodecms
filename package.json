{
  "name": "@headcodecms/root",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6",
    "turbo": "^2.6",
    "typescript": "5.9"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "csstype": "^3.2.3",
      "@types/react": "^19.2.6",
      "@types/react-dom": "^19.2.3"
    }
  }
}

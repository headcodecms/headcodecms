# DEFAULT CONFIGURATION:
# Best for local development and try out

# LIBSQL_URL=file:headcode.db

# Generate at: https://www.better-auth.com/docs/installation
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# FILE_STORAGE_FOLDER=public/storage


# OPTIONAL CONFIGURATION:

# DATABASE OPTIONS:

# Turso Cloud: https://turso.tech/
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# STORAGE OPTIONS:

# Vercel BLOB
# BLOB_READ_WRITE_TOKEN=
# Update next.config.ts and add:
#  images: {
#    remotePatterns: [new URL('https://<STORE_ID>.public.blob.vercel-storage.com/**')],
#  },
# See: https://nextjs.org/docs/app/api-reference/components/image#remotepatterns

# Uploadthing: https://uploadthing.com
# UPLOADTHING_TOKEN=
# Update next.config.ts and add:
#  images: {
#    remotePatterns: [new URL('https://<APP_ID>.ufs.sh/f/**')],
#  },
# See: https://nextjs.org/docs/app/api-reference/components/image#remotepatterns

# URLs in Headcode CMS admin
# NEXT_PUBLIC_STORAGE_URL="https://vercel.com/<ORG>/~/stores/blob/<STORE_ID>/browser"
# NEXT_PUBLIC_STORAGE_TITLE="Vercel BLOB"
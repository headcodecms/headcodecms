{
  "name": "headcode-cloudflare",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "preview": "vite preview --port 3001",
    "release": "node --env-file-if-exists=.env.local scripts/release.mts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mts",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "cf workers types >/dev/null && next typegen && tsc --noEmit",
    "test": "vitest run",
    "mcp": "node --env-file=.env.local scripts/mcp-smoke.mts",
    "parity": "node --env-file-if-exists=.env.local scripts/parity.mts"
  },
  "dependencies": {
